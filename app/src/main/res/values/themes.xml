<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="paper">#FBF9F5</color>
    <color name="ic_launcher_background">#0B6E64</color>

    <!-- Window theme. Compose draws everything; this only sets the pre-Compose window. -->
    <style name="Theme.Deckle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Deckle.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Deckle</item>
    </style>
</resources>
